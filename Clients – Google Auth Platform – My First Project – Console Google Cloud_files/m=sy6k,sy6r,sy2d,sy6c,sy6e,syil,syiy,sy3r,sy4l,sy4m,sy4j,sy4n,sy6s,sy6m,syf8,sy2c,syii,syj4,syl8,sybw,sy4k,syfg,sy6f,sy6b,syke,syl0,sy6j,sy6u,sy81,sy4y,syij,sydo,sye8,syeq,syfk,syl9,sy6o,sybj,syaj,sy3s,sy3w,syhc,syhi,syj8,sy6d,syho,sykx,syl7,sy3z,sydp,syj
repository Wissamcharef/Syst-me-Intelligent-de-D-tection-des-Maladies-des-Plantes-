"cloud/analysis/concord/configs/cuj/tasks/bigquery/bqUXR_export_results_to_GCS.yaml":"task:\n- id: bqUXR_export_results_to_GCS\n  group_label: prod\n  name: Export Results to GCS Triggered Survey\n  description: |-\n    CUJ task defined in slides:\n    docs/presentation/d/1HO13CvCcrqnnEMWSXtv5E9vWRMJ11LlYLKgzIzHfck4?slide=id.g3613cddf1cf_0_0&pli=1&resourcekey=0-2jYDyvwY-c3fSCASwnNP8A#slide=id.g3613cddf1cf_0_0\n\n    Export Results to GCS\n  product_name: BigQuery\n  implementation:\n  - name: query_result_action_bar\n    signal:\n    - id: click_GCS\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqResults\n          event_name: startSaveAsToGCS\n      type: BEGIN\n      description: Task starts when user clicks Cloud Storage from save results\n    - id: GCS_Save_Complete\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqResults\n          event_name: saveAsToGCS\n      type: COMPLETE\n      description: CUJ-task ends in a \u201ccompleted\u201d state when job completes, and table\n        has been exported to GCS\n    - id: GCS_Limited_Save\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqResults\n          event_name: failedSaveAsToGCS\n      type: FAIL\n      description: CUJ-task fails when export job fails\n    - id: GCS_Cancel\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqResults\n          event_name: cancelSaveAsToGCS\n      type: TERMINATE\n      description: Task is terminated if user clicks \u2018cancel\u2019 in subtask\n",
