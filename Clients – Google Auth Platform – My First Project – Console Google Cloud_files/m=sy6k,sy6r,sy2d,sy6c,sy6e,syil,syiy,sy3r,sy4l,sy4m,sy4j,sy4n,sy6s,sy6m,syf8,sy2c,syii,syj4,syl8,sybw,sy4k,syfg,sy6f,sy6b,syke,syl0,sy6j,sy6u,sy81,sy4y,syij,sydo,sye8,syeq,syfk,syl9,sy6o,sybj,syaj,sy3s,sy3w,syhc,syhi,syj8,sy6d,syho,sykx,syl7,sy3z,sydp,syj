"cloud/analysis/concord/configs/cuj/tasks/bigquery/bqUXR_saveCSVLocal.yaml":"task:\n- id: bqUXR_saveCSVLocal\n  group_label: prod\n  description: |-\n    CUJ task defined in slides:\n    https://docs.google.com/presentation/d/1HO13CvCcrqnnEMWSXtv5E9vWRMJ11LlYLKgzIzHfck4/edit?resourcekey=0-2jYDyvwY-c3fSCASwnNP8A&slide=id.g33fd7bbeca1_1_0#slide=id.g33fd7bbeca1_1_0\n\n    Saving a dataset to a local CSV file\n  product_name: BigQuery\n  implementation:\n  - name: new_implementation\n    signal:\n    - id: click_CSV_Local\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqResults\n          event_name: startSaveAsToCSVLocal\n      type: BEGIN\n      description: Task starts when user clicks CSV (local file) from save results\n        menu\n    - id: CSVLocal_Save_Complete\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqResults\n          event_name: saveAsToCSVLocal\n      type: COMPLETE\n      description: CUJ-task ends in a \u201ccompleted\u201d state when job completes, and local\n        CSV has been downloaded\n    - id: CSV_Local_Cancel\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqResults\n          event_name: cancelSaveAsToCSVLocal\n      type: TERMINATE\n      description: Task is terminated if user clicks \u2018cancel\u2019 in progress popup\n    - id: CSVLocal_Limited_Save\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqResults\n          event_name: limitedSaveAsToCSVLocal\n      type: FAIL\n      description: CUJ-task fails when CSV is partially saved due to export limitation\n    begin_date: '2025-03-06'\n",
"cloud/analysis/concord/configs/cuj/tasks/bigquery/bqUXR_share_query.yaml":'task:\n- id: bqUXR_share_query\n  group_label: prod\n  description: |-\n    CUJ task defined in slides:\n    https://docs.google.com/presentation/d/1HO13CvCcrqnnEMWSXtv5E9vWRMJ11LlYLKgzIzHfck4/edit?resourcekey=0-2jYDyvwY-c3fSCASwnNP8A#slide=id.g32cab62c069_0_14\n\n    Sharing a query through the big query console\n  product_name: BigQuery\n  implementation:\n  - name: new_implementation\n    signal:\n    - id: shareQueryPanelOpened\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqManagePermissions\n          event_name: shareQueryPanelOpened\n      type: BEGIN\n      description: |-\n        CUJ-task starts when user clicks one of the following\n        \u201cManage Permissions\u201d from share button\n        \u201cManage Permissions\u201d from snowman menu\n        And Share permissions panel opens\n    - id: permissionsUpdated\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqManagePermissions\n          event_name: permissionsUpdated\n      type: COMPLETE\n      description: CUJ-task ends in a \u201ccompleted\u201d state when \u201cPolicy updated\u201d dialog\n        appears\n    - id: shareQueryPanelClosed\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqManagePermissions\n          event_name: shareQueryPanelClosed\n      type: TERMINATE\n      description: "Panel is closed without sharing a query. \\n\\nHappens when user:\\n\\\n        Clicks close\\nClicks anywhere outside the panel. \\n"\n',
"cloud/analysis/concord/configs/cuj/tasks/bigquery/bq_add_data.yaml":"task:\n- id: bq_add_data\n  group_label: prod\n  name: Add Data\n  description: Add Data to Bigquery. Starts when user opens the add data panel, and\n    ends with success if the create table custom event is fired.\n  product_name: bigquery\n  implementation:\n  - name: new_implementation\n    signal:\n    - id: add_data_panel_open\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqAddData\n          event_name: addDataOpen\n      type: BEGIN\n      description: Signal fires when add data right hand panel opens\n    - id: add_data_success\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqTableCreate\n          event_name: trackCreateTableSubmitSuccess\n      type: COMPLETE\n      description: Signal fires when table has been created successfully\n    begin_date: '2024-01-01'\n    version: '1'\n  type: CREATE\n",
"cloud/analysis/concord/configs/cuj/tasks/bigquery/bq_studio_reference_panel.yaml":"task:\n- id: bq_studio_reference_panel\n  group_label: prod\n  name: Open reference and run query\n  product_name: BigQuery\n  implementation:\n  - name: reference_panel_and_run_query\n    signal:\n    - id: open_reference_panel\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqReferencePanel\n          event_name: openReferencePanel\n      type: BEGIN\n      description: Open the Reference panel in BQ Studio\n    - id: bq_run_query_signal\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqQueryEditor\n          event_name: runQuery\n      type: COMPLETE\n      description: Run a query\n    begin_date: '2026-02-05'\n  definition_metadata: {}\n",
"cloud/analysis/concord/configs/cuj/tasks/bigquery/bquxrSURVEYONLY_schedule_query.yaml":"task:\n- id: bquxrSURVEYONLY_schedule_query\n  group_label: prod\n  name: 'Schedule a Query Triggered Survey '\n  description: 'DO NOT USE THIS FOR TELEMETRY! This is a YAML specifically for triggering\n    a survey to those who have completed scheduling their query as well as those who\n    failed scheduling their query. As such, the FAIL actions have been marked as \"COMPLETE\"\n    signals. '\n  product_name: BigQuery\n  implementation:\n  - signal:\n    - id: schedule_query_panel_opens\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqScheduledQuery\n          event_name: panelOpened\n      type: BEGIN\n      description: CUJ-task starts when user clicks \u201cschedule\u201d & the Export as scheduled\n        query panel opens.\n    - id: schedule_query_created\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqScheduledQuery\n          event_name: created\n      type: COMPLETE\n      description: CUJ-task ends in a \u201ccompleted\u201d state when user clicks \u201csave\u201d &\n        the \u201cscheduled query created\u201d dialog appears.\n    - id: panel_closed_without_save\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqScheduledQuery\n          event_name: cancelled\n      type: COMPLETE\n      description: \"Panel is closed without saving a scheduled query. \\n\\nHappens\\\n        \\ when user:\\n- Clicks cancel\\n- Clicks anywhere outside the panel. \\n\"\n    - id: schedule_query_failed\n      front_end_signal:\n        console_type: CLOUD_CONSOLE\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqScheduledQuery\n          event_name: failed\n      type: COMPLETE\n",
"cloud/analysis/concord/configs/cuj/tasks/bigquery/bquxr_GeminiSQLGeneration.yaml":'task:\n- id: bquxr_GeminiSQLGeneration\n  group_label: prod\n  description: "CUJ task defined in slides: \\nhttps://docs.google.com/presentation/d/1HO13CvCcrqnnEMWSXtv5E9vWRMJ11LlYLKgzIzHfck4/edit?resourcekey=0-2jYDyvwY-c3fSCASwnNP8A&slide=id.g3746e970b80_0_20#slide=id.g3746e970b80_0_20"\n  product_name: BigQuery\n  implementation:\n  - name: new_implementation\n    signal:\n    - id: gemini_code_gen_panel_open\n      front_end_signal:\n        console_type: Cloud_Console\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqAtlasCodeAssist\n          event_name: gemini_code_gen_panel_open\n      type: BEGIN\n      description: User clicks opens the generate SQL with Gemini panel (via either\n        the gemini wand icon or starting link)\n    - id: gemini_code_gen_generate\n      front_end_signal:\n        console_type: Cloud_Console\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqAtlasCodeAssist\n          event_name: gemini_code_gen_generate\n      description: user clicks generate in the SQL code generation panel\n    - id: gemini_code_gen_insert\n      front_end_signal:\n        console_type: Cloud_Console\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqAtlasCodeAssist\n          event_name: gemini_code_gen_insert\n      type: COMPLETE\n      description: User clicks insert in the "Generate SQL with Gemini" panel\n    - id: gemini_code_gen_discard\n      front_end_signal:\n        console_type: Cloud_Console\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqAtlasCodeAssist\n          event_name: gemini_code_gen_discard\n      type: TERMINATE\n      description: user clicks "Discard" button\n    - id: gemini_code_gen_panel_close\n      front_end_signal:\n        console_type: Cloud_Console\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqAtlasCodeAssist\n          event_name: gemini_code_gen_panel_close\n      type: TERMINATE\n      description: user closes "Generate SQL with Gemini" panel\n    - id: gemini_code_gen_fail\n      front_end_signal:\n        console_type: Cloud_Console\n        page_path: /bigquery\n        client_event_signal:\n          event_type: bqAtlasCodeAssist\n          event_name: gemini_code_gen_fail\n      type: FAIL\n      description: CUJ is failed when gemini sends an error message instead of generating\n        SQL\n    begin_date: \'2024-08-11\'\n',
